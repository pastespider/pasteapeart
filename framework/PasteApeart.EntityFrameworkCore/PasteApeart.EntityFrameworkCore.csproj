<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<!-- 启用确定性编译（关键） -->
		<Deterministic>true</Deterministic>
		<!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>PasteApeart.EntityFrameworkCore</RootNamespace>
		<DocumentationFile>PasteApeart.EntityFrameworkCore.xml</DocumentationFile>
		<FileVersion>26.8.1</FileVersion>
		<VersionPrefix>26.8.1</VersionPrefix>
		<AssemblyVersion>26.8.1</AssemblyVersion>
		<Platforms>AnyCPU;ARM64;x64</Platforms>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>
	<ItemGroup>
		<None Include="readme.md" Pack="true" PackagePath="/" Visible="true" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="PasteApeart.Domain" Version="26.7.4" />
	</ItemGroup>
	<!-- 该组仅在 TargetFramework 为 net8.0 时生效 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">

		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
		<!--<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0.0" />-->
	</ItemGroup>

	<!-- 该组仅在 TargetFramework 为 net8.0 时生效 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<!--<PackageReference Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.0" />-->

		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.4" />
		<!--<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="8.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="8.0.0.0" />-->
	</ItemGroup>
	

	
	
</Project>
