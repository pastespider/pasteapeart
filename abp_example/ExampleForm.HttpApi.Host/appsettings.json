{
  "App": {
    "CorsOrigins": "http://localhost:44307"
  },
  "ConnectionStrings": {
    "MainConnectionString": "User id=postgres;Password=123456;Host=my.host.com;Port=5555;Database=planorderdb;Pooling=true;Connection Lifetime=0;MaxPoolSize=10;",
    "SqliteConnectionString": "Data Source=data/template.db",
    "SqliteReadOnly": "Data Source=data/test.db",
    "DataType": "sqlite", //数据库的类型sqlite或者pgsql
    "CacheType": "memory" //redis或者memory 缓存的类型
  },
  "Redis": {
    "MainConnection": "my.host.com:6379,$UNLINK=,abortConnect=false,defaultDatabase=1,ssl=false,ConnectTimeout=1800,allowAdmin=true,connectRetry=3,password=123456",
    "Prefix": "paste:"
  },
  "RateLimitOptions": {
    "FixedWindow": {
      "PolicyName": "fixed-policy",
      "PermitLimit": 15,
      "WindowInSeconds": 10,
      "QueueLimit": 3
    },
    "SlidingWindow": {
      "PolicyName": "sliding-policy",
      "PermitLimit": 30,
      "WindowInSeconds": 60,
      "Segments": 6,
      "QueueLimit": 2
    },
    "TokenBucket": {
      "PolicyName": "token-policy",
      "TokenLimit": 100,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodInSeconds": 5,
      "QueueLimit": 4
    },
    "Concurrency": {
      "PolicyName": "concurrency-policy",
      "PermitLimit": 8,
      "QueueLimit": 3
    }
  },
  "Serilog": {
    "LevelSwitches": {
      "$errorSwitch": "Error",
      "$infoSwitch": "Information",
      "$warnSwitch": "Warning"
    },
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "levelSwitch": "$infoSwitch", //也可以使用 restrictedToMinimumLevel:Information
          "rollingInterval": "Day", // "创建文件的类别，可以是分钟，小时，天，月,年": null, 
          "retainedFileCountLimit": 60, // "--设置日志文件个数最大值，默认31，意思就是只保留最近的31个日志文件", "等于null时永远保留文件": null,
          "fileSizeLimitBytes": 3145728, //设置单个文件大小为3M 默认1G
          "rollOnFileSizeLimit": true //超过文件大小后创建新的
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/warning.txt",
          "levelSwitch": "$warnSwitch",
          "rollingInterval": "Day", // "创建文件的类别，可以是分钟，小时，天，月,年": null,
          "retainedFileCountLimit": 60, // "--设置日志文件个数最大值，默认31，意思就是只保留最近的31个日志文件", "等于null时永远保留文件": null,
          "fileSizeLimitBytes": 3145728, //设置单个文件大小为3M 默认1G
          "rollOnFileSizeLimit": true //超过文件大小后创建新的
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error.txt",
          "levelSwitch": "$errorSwitch",
          "rollingInterval": "Day", // "创建文件的类别，可以是分钟，小时，天，月,年": null,
          "retainedFileCountLimit": 60, // "--设置日志文件个数最大值，默认31，意思就是只保留最近的31个日志文件", "等于null时永远保留文件": null,
          "fileSizeLimitBytes": 3145728, //设置单个文件大小为3M 默认1G
          "rollOnFileSizeLimit": true //超过文件大小后创建新的
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
