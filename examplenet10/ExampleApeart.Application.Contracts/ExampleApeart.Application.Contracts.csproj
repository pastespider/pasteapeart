<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExampleApeart.Application.Contracts</RootNamespace>
	    <DocumentationFile>..\ExampleApeart.HttpApi.Host\ExampleApeart.Application.Contracts.xml</DocumentationFile>
  </PropertyGroup>
	<ItemGroup>
		<PackageReference Include="PasteApeart.Application.Contracts" Version="26.10.5" />
	</ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ExampleApeart.Domain\ExampleApeart.Domain.csproj" />
  </ItemGroup>

</Project>
