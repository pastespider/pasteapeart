<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExampleApeart.Domain</RootNamespace>
		  <DocumentationFile>..\ExampleApeart.HttpApi.Host\ExampleApeart.Domain.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.9" />
    <!--<PackageReference Include="Volo.Abp.Ddd.Domain" Version="8.3.4" />-->
	  <PackageReference Include="PasteApeart.Helper" Version="26.8.1" />
	  <PackageReference Include="PasteApeart.Domain" Version="26.8.1" />
  </ItemGroup>

</Project>
