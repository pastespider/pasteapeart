<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <ImplicitUsings>enable</ImplicitUsings>

	  <FileVersion>26.9.3</FileVersion>
	  <VersionPrefix>26.9.3</VersionPrefix>
	  <AssemblyVersion>26.9.3</AssemblyVersion>
	  <PackageReadmeFile>readme.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
	  <None Include="readme.md" Pack="true" PackagePath="/" Visible="true" />
  </ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App"></FrameworkReference>
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Mapster" Version="10.0.8" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Autofac" Version="9.2.0" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageReference Include="StackExchange.Redis" Version="3.0.0" />
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
		<PackageReference Include="Mapster" Version="7.4.0" />
		<PackageReference Include="Mapster.DependencyInjection" Version="1.0.0" />
		<PackageReference Include="Autofac" Version="8.0.0" />
		<PackageReference Include="Autofac.Extensions.DependencyInjection" Version="8.0.0" />	
		<PackageReference Include="StackExchange.Redis" Version="2.8.58" />
		<PackageReference Include="RabbitMQ.Client" Version="7.1.2" />
	</ItemGroup>


	<!-- 该组仅在 TargetFramework 为 net8.0 时生效 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.4" />
	</ItemGroup>

	<!-- 该组仅在 TargetFramework 为 net8.0 时生效 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.4" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<ProjectReference Include="..\PasteApeart.Domain\PasteApeart.Domain.csproj" />
		<ProjectReference Include="..\PasteApeart.Application.Contracts\PasteApeart.Application.Contracts.csproj" />
		<!--<ProjectReference Include="..\PasteApeart.EntityFrameworkCore\PasteApeart.EntityFrameworkCore.csproj" />-->
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="PasteApeart.Domain" Version="26.9.1" />
		<PackageReference Include="PasteApeart.Application.Contracts" Version="26.9.2" />
		<!--<PackageReference Include="PasteApeart.EntityFrameworkCore" Version="26.7.1" />-->
	</ItemGroup>

</Project>
