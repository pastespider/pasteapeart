<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PasteApeart.EntityFrameworkCore</RootNamespace>
	    <DocumentationFile>..\PasteApeart.HttpApi.Host\PasteApeart.EntityFrameworkCore.xml</DocumentationFile>
  </PropertyGroup>


  <ItemGroup>
	   <!-- <PackageReference Include="Volo.Abp.EntityFrameworkCore.PostgreSql" Version="8.3.4" />-->
