<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExampleApeart.Domain</RootNamespace>
		  <DocumentationFile>..\ExampleApeart.HttpApi.Host\ExampleApeart.Domain.xml</DocumentationFile>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore.Abstractions" Version="8.0.19" />
    <!--<PackageReference Include="Volo.Abp.Ddd.Domain" Version="8.3.4" />-->
  </ItemGroup>


	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<ProjectReference Include="..\..\framework\PasteApeart.Domain\PasteApeart.Domain.csproj" />
		<ProjectReference Include="..\..\framework\PasteApeart.Helper\PasteApeart.Helper.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<PackageReference Include="PasteApeart.Domain" Version="26.9.16" />
		<PackageReference Include="PasteApeart.Helper" Version="26.9.16" />
	</ItemGroup>
	
</Project>
