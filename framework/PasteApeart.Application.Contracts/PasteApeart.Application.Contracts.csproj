<Project Sdk="Microsoft.NET.Sdk">


  <PropertyGroup>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
	  <!-- 启用确定性编译（关键） -->
	  <Deterministic>true</Deterministic>
	  <!-- 用于CI环境，确保与本地编译一致（可选但推荐） -->
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PasteApeart.Application.Contracts</RootNamespace>
	    <DocumentationFile>PasteApeart.Application.Contracts.xml</DocumentationFile>
	  <FileVersion>26.8.2</FileVersion>
	  <VersionPrefix>26.8.2</VersionPrefix>
	  <AssemblyVersion>26.8.2</AssemblyVersion>
	  <PackageReadmeFile>readme.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
	  <None Include="readme.md" Pack="true" PackagePath="/" Visible="true" />
  </ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App"></FrameworkReference>
	</ItemGroup>
  <ItemGroup>
	  <PackageReference Include="PasteApeart.Helper" Version="26.8.1" />
    <!--<ProjectReference Include="..\PasteApeart.Domain\PasteApeart.Domain.csproj" />-->
	  <PackageReference Include="PasteApeart.Domain" Version="26.8.1" />
  </ItemGroup>

</Project>
